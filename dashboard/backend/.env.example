# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

APP_NAME="Warden Dashboard API"
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# Comma-separated list is fine too, e.g. ["http://localhost:5173","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:5173"]

# SQLite for local dev. Point this at Postgres in staging/production.
DATABASE_URL=sqlite:///./warden.db

# Get this from the Slack app's "Basic Information" page once M4+ wires up Slack.
SLACK_SIGNING_SECRET=

RATE_LIMIT_DEFAULT=60/minute
